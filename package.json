{
  "name": "pterocontrol",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @zettako/bot",
    "dev": "npm run dev -w @zettako/bot",
    "deploy-commands": "npm run deploy-commands -w @zettako/bot",
    "db:generate": "npm run db:generate -w @zettako/bot",
    "db:migrate": "npm run db:migrate -w @zettako/bot",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"packages/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
