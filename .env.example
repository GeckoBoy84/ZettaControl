# Copy to .env and fill in. Never commit .env.

# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one guild only (instant updates while developing)
DISCORD_DEV_GUILD_ID=

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/zettacontrol

# 32 random bytes, base64. Encrypts stored panel API keys. Losing it means every
# linked panel has to be re-linked. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Comma separated Discord user IDs with owner commands
OWNER_IDS=

# trace | debug | info | warn | error
LOG_LEVEL=info

# Self-hosting with a panel on your own network (192.168.x.x, localhost)? Set to true.
# Leave false on a public bot: it stops users pointing the bot at internal addresses.
ALLOW_PRIVATE_PANEL_URLS=false

# Optional: path to a hooks module (see private.example/). Defaults to ./private/index.ts if present.
PRIVATE_HOOKS=
